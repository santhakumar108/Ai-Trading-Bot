# Copy this file to .env and fill in real values. NEVER commit the real .env
# file to version control.

# --- Safety switches ---------------------------------------------------
# Leave these as-is. Do not flip LIVE_TRADING_ENABLED here casually --
# see README.md "Real-Money Readiness Checklist" first. Even with this set
# to true, the shipped PaperBroker is physically incapable of live orders;
# a live broker connector would need to be added deliberately.
LIVE_TRADING_ENABLED=false
EMERGENCY_STOP=false

# --- Paper trading -------------------------------------------------------
PAPER_STARTING_CAPITAL=1000000

# --- Optional: point at a non-default config file ------------------------
# TRADING_CONFIG_PATH=config.yaml

# --- Optional: future broker API credentials (NOT used by PaperBroker) ---
# Never hard-code these in source. Add real broker connectors under
# broker/ as new BrokerInterface subclasses that read from here.
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_ACCESS_TOKEN=

# --- Optional: paid news/social data providers ----------------------------
# The default news/sentiment adapters use free sources (Google News RSS,
# public Reddit search) and need no keys. To use a paid provider instead,
# implement a new NewsSourceAdapter / SocialSourceAdapter and read its
# credentials from env vars here.
# NEWSAPI_KEY=
# TWITTER_BEARER_TOKEN=

# --- Data provider selection (spec section 21) ----------------------------
# Configuration-based, not hard-coded. See config/providers.py for the
# factory that reads these. Leave unset to use config/default_config.yaml's
# `providers:` section (yfinance / google_rss / yfinance / reddit).
#   MARKET_DATA_PROVIDER   -- "yfinance" | "none"
#   NEWS_PROVIDER          -- "google_rss" | "none"
#   FUNDAMENTALS_PROVIDER  -- "yfinance" | "none"
#   SOCIAL_PROVIDER        -- "reddit" | "none"
# "none" is the honest no-op for that domain (always reports "unavailable",
# never fabricates data) -- useful for fully offline/deterministic runs.
# MARKET_DATA_PROVIDER=yfinance
# NEWS_PROVIDER=google_rss
# FUNDAMENTALS_PROVIDER=yfinance
# SOCIAL_PROVIDER=reddit
